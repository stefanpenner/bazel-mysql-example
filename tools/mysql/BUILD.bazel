# gazelle:ignore

load(":toolchain.bzl", "current_mysql", "declare_mysql_toolchains", "mysql_datadir")

exports_files(
    ["mysqld.cnf"],
    visibility = ["//visibility:public"],
)

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

current_mysql(
    name = "current",
    testonly = True,
    visibility = ["//visibility:public"],
)

mysql_datadir(
    name = "datadir",
    testonly = True,
    visibility = ["//visibility:public"],
)

declare_mysql_toolchains()

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)
