load("@rules_go//go:def.bzl", "go_library", "go_test")

# This test does not start mysqld.

go_library(
    name = "copy",
    srcs = [
        # Gazelle drops a file whose name or build tag names an OS.
        "clone_darwin.go",  # keep
        "clone_linux.go",  # keep
        "clone_other.go",  # keep
        "copy.go",
    ],
    importpath = "github.com/stefanpenner/bazel-mysql/tools/mysql/copy",
    visibility = ["//visibility:public"],
)

go_test(
    name = "copy_test",
    srcs = ["copy_test.go"],
    embed = [":copy"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
