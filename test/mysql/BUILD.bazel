load("@rules_go//go:def.bzl", "go_library", "go_test")

# This test does not start mysqld. Keep go_test.
# gazelle:map_kind go_test go_test @rules_go//go:def.bzl

go_library(
    name = "mysql",
    srcs = [
        # Gazelle drops a file whose name or build tag names an OS.
        "clone_darwin.go",  # keep
        "clone_linux.go",  # keep
        "clone_other.go",  # keep
        "copy.go",
    ],
    importpath = "github.com/stefanpenner/bazel-mysql/test/mysql",
    visibility = ["//visibility:public"],
)

go_test(
    name = "mysql_test",
    srcs = ["copy_test.go"],
    embed = [":mysql"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
