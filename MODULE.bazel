module(
    name = "bazel_mysql",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.4")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_go_sql_driver_mysql",
    "com_github_stretchr_testify",
)

# MySQL Community Server. BCR has no server module.
# The extension registers one archive per platform. A toolchain selects one.
mysql = use_extension("//tools/mysql:extensions.bzl", "mysql", dev_dependency = True)
mysql.server(version = "8.4.13")
use_repo(
    mysql,
    "mysql_darwin_arm64",
    "mysql_linux_amd64",
    "mysql_linux_arm64",
)

register_toolchains(
    "//tools/mysql:mysql_darwin_arm64_toolchain",
    "//tools/mysql:mysql_linux_arm64_toolchain",
    "//tools/mysql:mysql_linux_amd64_toolchain",
    dev_dependency = True,
)
